# ============================================================================
# MATPLAN & RADAR - MILJØVARIABLER (.env.local)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. GOOGLE IDENTITY SERVICES (Sign In With Google OAuth Client ID)
# ----------------------------------------------------------------------------
# Hentes fra: https://console.cloud.google.com -> APIs & Services -> Credentials
# Type: Web Application. Sett "Authorized JavaScript origins" til ditt domene (f.eks. https://brukernavn.github.io og http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=ditt-prosjekt-id.apps.googleusercontent.com

# ----------------------------------------------------------------------------
# 2. SUPABASE REST SKY-SYNK (Sanntid mellom iPhone og Laptop)
# ----------------------------------------------------------------------------
# Hentes fra: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://ditt-prosjekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-lange-supabase-anon-key

# ----------------------------------------------------------------------------
# 3. BACKEND & PIPELINE-NØKLER (Brukes under cron-jobb / scripts / server)
# ----------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...
# GOOGLE_MAPS_API_KEY=AIzaSy...
# KASSALAPP_API_KEY=...

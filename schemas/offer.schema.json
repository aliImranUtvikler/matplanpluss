{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matplan-tilbud-norge.local/schemas/offer.schema.json",
  "title": "WeeklyOffersDataset",
  "description": "JSON Schema for ukentlige normaliserte dagligvaretilbud (vegansk og peanøttfri matplanlegging)",
  "type": "object",
  "required": [
    "fetchedAt",
    "weekNumber",
    "year",
    "totalOffers",
    "offers"
  ],
  "additionalProperties": false,
  "properties": {
    "fetchedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 tidspunkt for når datasettet ble generert/hentet"
    },
    "weekNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 53,
      "description": "ISO-ukenummer tilbudene gjelder for"
    },
    "year": {
      "type": "integer",
      "minimum": 2024,
      "maximum": 2100,
      "description": "Årstall tilbudene gjelder for"
    },
    "totalOffers": {
      "type": "integer",
      "minimum": 0,
      "description": "Totalt antall verifiserte tilbud i datasettet"
    },
    "offers": {
      "type": "array",
      "description": "Liste over normaliserte, veganske og peanøttfrie tilbud",
      "items": {
        "$ref": "#/$defs/NormalizedOffer"
      }
    }
  },
  "$defs": {
    "StoreChain": {
      "type": "string",
      "enum": [
        "REMA_1000",
        "KIWI",
        "MENY",
        "COOP_EXTRA",
        "SPAR",
        "JOKER",
        "ODA"
      ],
      "description": "Norsk dagligvarekjede"
    },
    "OfferCategory": {
      "type": "string",
      "enum": [
        "Frukt & Grønt",
        "Tørrvarer/Belgvekster",
        "Kjøl/Tofu",
        "Krydder/Sauser",
        "Annet"
      ],
      "description": "Hovedkategori i matplanens struktur"
    },
    "OfferSource": {
      "type": "string",
      "enum": [
        "KASSALAPP_API",
        "MATTILBUD_SCRAPER",
        "MATTILBUD_OCR",
        "SEED_FALLBACK"
      ],
      "description": "Kilde for datainnhenting"
    },
    "NormalizedOffer": {
      "type": "object",
      "required": [
        "id",
        "productName",
        "normalizedTags",
        "chain",
        "category",
        "offerPrice",
        "validFrom",
        "validUntil",
        "source",
        "isVeganSafe"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unik ID for tilbudet"
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "description": "Produktets originale navn i kundeavis/API"
        },
        "normalizedTags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Normaliserte søkbare nøkkelord (f.eks. 'tofu', 'røde linser', 'brokkoli')"
        },
        "chain": {
          "$ref": "#/$defs/StoreChain"
        },
        "category": {
          "$ref": "#/$defs/OfferCategory"
        },
        "offerPrice": {
          "type": "number",
          "minimum": 0,
          "description": "Tilbudspris i NOK"
        },
        "regularPrice": {
          "type": "number",
          "minimum": 0,
          "description": "Ordinær pris i NOK (hvis kjent)"
        },
        "discountAmountNok": {
          "type": "number",
          "minimum": 0,
          "description": "Rabatt i kroner (regularPrice - offerPrice) eller estimert besparelse"
        },
        "discountPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Rabatt i prosent (0-100)"
        },
        "unitDescription": {
          "type": "string",
          "description": "Mengde/enhet (f.eks. '400g', '1 stk', '2 pk', 'pr kg')"
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0,
          "description": "Pris per kg/liter hvis oppgitt"
        },
        "validFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Fra-dato (ISO 8601 YYYY-MM-DD)"
        },
        "validUntil": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Til-dato (ISO 8601 YYYY-MM-DD)"
        },
        "source": {
          "$ref": "#/$defs/OfferSource"
        },
        "imageUrl": {
          "type": "string",
          "description": "Evt. bilde-URL av produktet"
        },
        "flyerImageUrl": {
          "type": "string",
          "description": "Direkte URL til den faktiske nedlastede kundeavis-siden (WebP) i public/data/flyers/..."
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1,
          "description": "Sidetall i ukens kundeavis hvor tilbudet står trykket"
        },
        "isVeganSafe": {
          "type": "boolean",
          "const": true,
          "description": "Er varen bekreftet 100% vegansk & 100% peanøttfri?"
        }
      }
    }
  }
}
